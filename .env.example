# ---------------------------------------------------------------
# RootSym — environment
# Copy to .env for local work; set the same keys in your host's
# dashboard for production.
# ---------------------------------------------------------------

# --- Database (required) ---------------------------------------
# Must be a NEON connection string: the app talks to Postgres over Neon's
# WebSocket driver, because Cloudflare Workers cannot open the raw TCP socket
# that node-postgres needs. Use the POOLED string and keep sslmode=require.
DATABASE_URL="postgresql://user:password@host/rootsym?sslmode=require"

# --- Admin sign in (required) ----------------------------------
ADMIN_EMAIL="rand.ali.saleh1@hotmail.com"
# Either a plain password…
ADMIN_PASSWORD="change-this-to-something-long"
# …or a bcrypt hash, which takes priority when both are set:
# ADMIN_PASSWORD_HASH="$2b$12$…"

# Random string, 32+ characters. Signs the admin session cookie.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="generate-a-long-random-string"

# --- First deploy only -----------------------------------------
# Set to "true" for the very first deploy against an empty database, so the
# build seeds the RCA workshop and the site settings. Set it back to "false"
# afterwards. The seed never overwrites rows that already exist.
SEED_ON_BUILD="false"

# --- Site (required in production) -----------------------------
# No trailing slash. Joining links and Stripe redirects are built from this.
NEXT_PUBLIC_SITE_URL="https://rootsym.com"

# --- Card payments (leave empty) --------------------------------
# Stripe does not onboard merchants based in Jordan, so these stay blank and
# the site runs on CliQ / bank transfer. The CliQ alias and bank details are
# entered in the admin panel, not here. See docs/PAYMENTS.md.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CURRENCY="jod"
STRIPE_RATE_PER_JOD="1.41"

# --- Transactional email (optional but strongly recommended) ----
# Without a key, emails are written to the server log instead of being
# sent, and joining links can be copied from the admin Bookings page.
RESEND_API_KEY=""
MAIL_FROM="RootSym <hello@rootsym.com>"
ADMIN_NOTIFY_EMAIL=""

# --- Public contact details (optional overrides) ----------------
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_LINKEDIN_URL=""
