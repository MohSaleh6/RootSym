# ---------------------------------------------------------------
# RootSym — environment
# Copy to .env for local work; set the same keys in your host's
# dashboard for production.
# ---------------------------------------------------------------

# --- Database (required) ---------------------------------------
# Must be a NEON connection string: the app talks to Postgres over Neon's
# WebSocket driver, because Cloudflare Workers cannot open the raw TCP socket
# that node-postgres needs. Use the POOLED string and keep sslmode=require.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/rootsym?sslmode=require"

# Optional. Migrations need a single session that can hold a lock, which a
# transaction-mode pooler cannot give them, so they run against the direct
# host instead. That host is derived from DATABASE_URL by dropping "-pooler"
# — set this only if your provider names the two hosts differently.
# DIRECT_DATABASE_URL=""

# --- Admin sign in (required) ----------------------------------
ADMIN_EMAIL="rand.ali.saleh1@hotmail.com"
# Either a plain password…
ADMIN_PASSWORD="change-this-to-something-long"
# …or a bcrypt hash, which takes priority when both are set:
# ADMIN_PASSWORD_HASH="$2b$12$…"

# Random string, 32+ characters. Signs the admin session cookie.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET="generate-a-long-random-string"

# --- First deploy only -----------------------------------------
# Set to "true" for the very first deploy against an empty database, so the
# build seeds the RCA workshop and the site settings. Set it back to "false"
# afterwards. The seed never overwrites rows that already exist.
SEED_ON_BUILD="false"

# --- Site (required in production) -----------------------------
# No trailing slash. Only a fallback: links inside emails are built from the
# request's own host, so pointing a domain at the site needs no rebuild.
NEXT_PUBLIC_SITE_URL="https://rootsym.com"

# --- Card payments ----------------------------------------------
# There are none, and no keys to set. Stripe does not onboard merchants based
# in Jordan, so the site runs on CliQ / bank transfer: the alias and bank
# details are entered in the admin panel, not here. See docs/PAYMENTS.md for
# what adding a gateway would involve.

# --- Sign in with Google (optional) -----------------------------
# Create an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add this exact
# authorised redirect URI:  https://<your-domain>/api/auth/google/callback
# (add one per domain you use — the workers.dev one as well as the real one).
# Leave both blank and the Google button simply does not appear; email and
# password sign-in is unaffected.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Transactional email (optional but strongly recommended) ----
# Without a key, emails are written to the server log instead of being
# sent, and joining links can be copied from the admin Bookings page.
RESEND_API_KEY=""
MAIL_FROM="RootSym <hello@rootsym.com>"
# Where "someone just booked" lands. Defaults to ADMIN_EMAIL when blank.
ADMIN_NOTIFY_EMAIL=""

# --- Public contact details (optional overrides) ----------------
# Left blank, the footer and contact page fall back to the email and mobile
# number from the CV — a personal mobile, published on a public site. Set a
# business address and number here if that is not what you want.
#
# Every NEXT_PUBLIC_ value is baked into the JavaScript when the site is
# built, so on Cloudflare these belong in Settings → Build → Variables.
# Adding them as runtime Secrets instead does nothing at all: the build has
# already finished by the time a secret is readable.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_LINKEDIN_URL=""
# Full international form, digits only, no plus. Defaults to the contact
# number. This is where a customer is sent to confirm a transfer.
NEXT_PUBLIC_WHATSAPP=""
